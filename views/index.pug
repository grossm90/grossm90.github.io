doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew L. Gross

        include includes/css.pug

body
    include includes/header.pug
    section.row
        div.grid
            section.about
                div.col-2-3
                    h2 About Me
                    p I am a STEM teacher at J.P. Taravella High School. I teach engineering and game design/programming. I am also a lifelong tinkerer, maker and learner. I love putting new things into the world, whether that is through woodworking, art, or coding. Passing on a maker mindset is at the core of my teaching philosophy.
                aside.col-1-3
                    div.about-info
                        img(src="../images/about/matthew-gross.png", alt='Matthew Gross')
                        ul
                            li 
                                a(href="https://github.com/JPT-Gross", target="_blank") Github
                            li
                                a(href="https://youtube.com/@JPTengineering", target="_blank") @JPTengineeing
    include includes/footer.pug
