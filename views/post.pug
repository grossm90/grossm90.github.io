doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew L. Gross

        include includes/css.pug

body
    include includes/header.pug
    section.row
        div.grid
            h1 #{post.title}
            h2 #{post.description}
            p #{post.content}
    include includes/footer.pug
