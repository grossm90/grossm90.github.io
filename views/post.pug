doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew L. Gross

        include includes/css.pug

body
    include includes/header.pug
    section.row
        div.grid
            .post
                h1 #{post.title}
                p.post-meta Posted on #{post.createdAt.toDateString()}          
                p.post-content #{post.content}
    include includes/footer.pug
