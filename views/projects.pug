doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew L. Gross

        include includes/css.pug
    body
        include includes/header.pug

        section.row-alt
            .lead.grid
                h2 Projects

        
        section.row-projects
            .grid
                section.projects.col-1-3
                    h5 School Database
                        a(href="https://browardcountyschools.sharepoint.com/sites/JPTTrekker", target="_blank")
                            img(src="../images/projects/lydia.png", alt="School Database")
                        h3 Lydia
                    p 
                        | Lydia is J.P. Taravella's internal database. Currently 
                        | it can aggergate student schedules, demographics and 
                        | parent contact information.
                
                section.projects.col-1-3
                    h5 Schedule Website
                        a(href="https://jptab.w3spaces.com", target="_blank")
                            img(src="../images/projects/silverblue.png", alt="JPT Schedule Webstite")
                        h3 Silver/Blue
                    p 
                        | This website allows schools to communicate their A/B 
                        | schedule to students and parents. It displays whether 
                        | it is an "A" or "B" day on the left, and the current 
                        | period on the right.
include includes/footer.pug
