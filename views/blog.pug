doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew L. Gross

        include includes/css.pug
    body
        include includes/header.pug
        section.row
            .grid
                each post in posts
                    .post-preview
                        a(href='/post/' + post.id) 
                            h2.post-title #{post.title}
                        p.post-meta Posted on #{post.createdAt.toDateString()}
                        p.post-description #{post.description}
                        hr

include includes/footer.pug
