doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')

        title Matthew L. Gross

        include includes/css.pug
    body
        include includes/header.pug
        section.row
            .grid
                ul
                    each post in posts
                        li 
                            a(href='/post/' + post.id) #{post.title} #{post.createdAt.toDateString()}

include includes/footer.pug
